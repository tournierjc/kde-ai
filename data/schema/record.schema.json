{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kde-ai.local/schema/record.json",
  "type": "object",
  "required": ["id", "messages", "meta"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "tool_calls": {"type": "array"}
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["domain", "issue_mode", "skills", "os", "plasma", "source"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["tools", "kde", "cachyos", "bug_search", "solve", "rag", "refuse", "dpo"]
        },
        "issue_mode": {"type": "boolean"},
        "skills": {"type": "array", "items": {"type": "string"}},
        "os": {"type": "string"},
        "plasma": {"type": "string"},
        "source": {"type": "string", "enum": ["gold", "xlam", "teacher", "template"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "dpo_kind": {"type": "string"}
      }
    },
    "chosen": {"type": "object"},
    "rejected": {"type": "object"}
  }
}
